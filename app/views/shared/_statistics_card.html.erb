<%# Statistics card %>
<% if (total_cigarettes && total_cigarettes > 0) || (participants && participants > 0) || (clean_ups && clean_ups > 0) %>
  <div class="mb-6 bg-white rounded-2xl shadow-lg p-6 border border-gray-100 relative z-10">
    <h3 class="text-sm font-medium text-gray-900 mb-4">
      Unsere bisherigen Erfolge
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <% if total_cigarettes && total_cigarettes > 0 %>
        <div class="bg-indigo-50 rounded-xl p-4">
          <div class="text-2xl font-bold text-indigo-600">
            <%= number_with_delimiter(total_cigarettes) %>
          </div>

          <div class="text-sm text-gray-600">Zigaretten gesammelt</div>
        </div>
      <% end %>

      <% if participants && participants > 0 %>
        <div class="bg-green-50 rounded-xl p-4">
          <div class="text-2xl font-bold text-green-600">
            <%= number_with_delimiter(participants) %>
          </div>

          <div class="text-sm text-gray-600">Registrierte Teilnehmer</div>
        </div>
      <% end %>

      <% if clean_ups && clean_ups > 0 %>
        <div class="bg-amber-50 rounded-xl p-4">
          <div class="text-2xl font-bold text-amber-600">
            <%= number_with_delimiter(clean_ups) %>
          </div>

          <div class="text-sm text-gray-600">Clean-Ups durchgeführt</div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>