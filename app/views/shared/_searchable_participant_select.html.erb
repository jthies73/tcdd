<%#
  Searchable participant select component
  
  Required locals:
    - participants: Collection of Participant objects to display
    - field_name: Name attribute for the hidden input field (default: "participant_id")
  
  Optional locals:
    - placeholder: Placeholder text for the search input (default: "Name suchen oder auswählen...")
    - input_class: Additional CSS classes for the input wrapper
    - style: :default or :card - determines the styling variant
%>

<% field_name ||= "participant_id" %>
<% placeholder ||= "Name suchen oder auswählen..." %>
<% style ||= :default %>

<% 
  # Style variants
  input_classes = case style
  when :card
    "block w-full rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 pr-10 text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:bg-white transition-colors sm:text-sm"
  else
    "block w-full h-[38px] rounded-md bg-white px-3 py-1.5 pr-10 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6"
  end

  list_classes = case style
  when :card
    "hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-60 overflow-auto"
  else
    "hidden absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-md shadow-lg max-h-60 overflow-auto"
  end

  item_classes = case style
  when :card
    "px-4 py-3 cursor-pointer hover:bg-indigo-50 border-b border-gray-100 last:border-b-0 transition-colors text-gray-900 sm:text-sm"
  else
    "px-3 py-2 cursor-pointer hover:bg-indigo-50 border-b border-gray-100 last:border-b-0 transition-colors text-gray-900 sm:text-sm"
  end

  no_results_classes = case style
  when :card
    "hidden px-4 py-3 text-gray-500 text-center sm:text-sm"
  else
    "hidden px-3 py-2 text-gray-500 text-center sm:text-sm"
  end
%>

<div data-controller="searchable-select" class="relative">
  <input type="hidden" name="<%= field_name %>" data-searchable-select-target="hiddenField">

  <div class="relative">
    <input
      type="text"
      data-searchable-select-target="input"
      data-action="input->searchable-select#filter focus->searchable-select#focusInput blur->searchable-select#hideList"
      placeholder="<%= placeholder %>"
      autocomplete="off"
      class="<%= input_classes %>"
    >

    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
      <svg
        class="w-5 h-5 text-gray-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
        />
      </svg>
    </div>
  </div>

  <ul
    data-searchable-select-target="list"
    class="<%= list_classes %>"
  >
    <% participants.each do |participant| %>
      <li
        data-searchable-select-target="item"
        data-id="<%= participant.id %>"
        data-name="<%= participant.name %>"
        data-people-count="<%= participant.people_count || 1 %>"
        data-action="click->searchable-select#select"
        class="<%= item_classes %>"
      >
        <%= participant.name %>
      </li>
    <% end %>

    <li
      data-searchable-select-target="noResults"
      class="<%= no_results_classes %>"
    >
      Kein Eintrag gefunden
    </li>
  </ul>
</div>
