<%# 
  Flash messages component for displaying alerts and notices
  
  This component automatically displays all flash messages with appropriate styling:
  - notice: Green success messages
  - alert: Red error messages
  - warning: Yellow warning messages
  - info: Blue information messages
%>

<% if flash.any? %>
  <div class="fixed top-4 right-4 z-50 space-y-2" data-controller="flash-messages">
    <% flash.each do |type, message| %>
      <%
        case type.to_s
        when 'notice'
          bg_color = 'bg-green-50'
          text_color = 'text-green-800'
          border_color = 'border-green-200'
          icon_color = 'text-green-400'
          icon_path = 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z'
        when 'alert', 'error'
          bg_color = 'bg-red-50'
          text_color = 'text-red-800'
          border_color = 'border-red-200'
          icon_color = 'text-red-400'
          icon_path = 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z'
        when 'warning'
          bg_color = 'bg-yellow-50'
          text_color = 'text-yellow-800'
          border_color = 'border-yellow-200'
          icon_color = 'text-yellow-400'
          icon_path = 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z'
        when 'info'
          bg_color = 'bg-blue-50'
          text_color = 'text-blue-800'
          border_color = 'border-blue-200'
          icon_color = 'text-blue-400'
          icon_path = 'M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z'
        else
          bg_color = 'bg-gray-50'
          text_color = 'text-gray-800'
          border_color = 'border-gray-200'
          icon_color = 'text-gray-400'
          icon_path = 'M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z'
        end
      %>
      
      <div class="rounded-md border <%= border_color %> <%= bg_color %> p-4 shadow-lg max-w-sm" 
           data-flash-messages-target="message"
           data-action="click->flash-messages#dismiss">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 <%= icon_color %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>" />
            </svg>
          </div>
          <div class="ml-3 flex-1">
            <p class="text-sm font-medium <%= text_color %>">
              <%= message %>
            </p>
          </div>
          <div class="ml-4 flex-shrink-0 flex">
            <button type="button" 
                    class="inline-flex <%= bg_color %> rounded-md <%= text_color %> hover:bg-opacity-75 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-green-50 focus:ring-green-600"
                    data-action="click->flash-messages#dismiss"
                    data-flash-messages-target="dismissButton">
              <span class="sr-only">Dismiss</span>
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>