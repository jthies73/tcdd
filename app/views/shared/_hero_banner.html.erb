<%# Hero banner with background image %>
<%
  # Default values
  icon_container_size ||= "w-20 h-20"
  icon_size ||= "w-12 h-12" 
  icon_margin ||= "mb-4"
  title ||= "Trashcan Dresden"
  subtitle ||= "Gemeinsam für eine saubere Stadt"
%>

<div class="relative h-100 overflow-hidden">
  <!-- Blurred background layer -->
  <div class="absolute inset-0 bg-cover bg-no-repeat" style="background-image: url('/thumbnail_1000124857.jpg'); background-position: center 80%; filter: blur(1px); transform: scale(1.1);"></div>
  
  <!-- Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/30 to-black/50"></div>
  
  <!-- Content layer (no blur) -->
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-6 drop-shadow-lg">
        <%= title %>
      </h1>
      
      <p class="text-lg sm:text-xl text-white text-opacity-95 drop-shadow-md">
        <%= subtitle %>
      </p>
    </div>
  </div>
</div>