<%#
  QR Code Modal component

  This modal displays a QR code linking to a participant's participation page.
  The QR code is generated dynamically via the qr_modal Stimulus controller.

  Usage:
  - Include this partial once in the page (not per-row)
  - Trigger with data-action="click->qr-modal#open"
  - Pass data-qr-url and data-participant-name on the triggering element
%>

<div
  data-qr-modal-target="modal"
  data-action="keydown@window->qr-modal#closeOnEscape click->qr-modal#closeOnOutsideClick"
  class="hidden fixed inset-0 z-50 overflow-y-auto"
  aria-labelledby="qr-modal-title"
  role="dialog"
  aria-modal="true"
>
  <%# Centered modal container %>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <%# Background overlay %>
    <div
      class="fixed inset-0 bg-gray-500/75 transition-opacity"
      aria-hidden="true"
    ></div>

    <%# Modal panel - centered %>
    <div class="relative bg-white rounded-lg p-6 shadow-xl max-w-sm w-full">
      <div class="flex flex-col items-center">
        <%# QR Code icon %>
        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-100 mb-4">
          <svg
            class="h-6 w-6 text-indigo-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75v-.75zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75v-.75zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75v-.75zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75v-.75z"
            />
          </svg>
        </div>

        <%# Title with participant name %>
        <h3
          class="text-lg leading-6 font-medium text-gray-900 text-center mb-4"
          id="qr-modal-title"
        >
          QR Code für <span data-qr-modal-target="participantName"></span>
        </h3>

        <%# QR Code container %>
        <div
          data-qr-modal-target="qrCode"
          class="flex items-center justify-center p-4 bg-white rounded-lg border border-gray-200"
        >
          <%# QR code will be generated here by JavaScript %>
        </div>

        <%# Hint text %>
        <p class="mt-4 text-sm text-gray-500 text-center">
          Scannen Sie diesen Code, um die Teilnahme-Seite zu öffnen.
        </p>
      </div>

      <div class="mt-6 flex justify-center">
        <button
          type="button"
          data-action="click->qr-modal#close"
          class="
            inline-flex justify-center rounded-md border border-gray-300
            shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700
            hover:bg-gray-50 focus:outline-none focus:ring-2
            focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer
          "
        >
          Schließen
        </button>
      </div>
    </div>
  </div>
</div>
