<%= turbo_stream_from :clean_ups %>

<div class="min-h-screen bg-gradient-to-b from-indigo-50 to-white">
  <%# Hero banner with background image %>
  <div class="relative h-64 sm:h-80 bg-cover bg-center bg-no-repeat" style="background-image: linear-gradient(rgba(99, 102, 241, 0.7), rgba(67, 56, 202, 0.8)), url('/thumbnail_1000124857.jpg');">
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-white bg-opacity-20 backdrop-blur-sm rounded-full shadow-xl mb-6 border-2 border-white border-opacity-30">
          <svg class="w-14 h-14 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/>
          </svg>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2 drop-shadow-lg">
          Trashcan Dresden
        </h1>

        <p class="text-lg sm:text-xl text-white text-opacity-95 drop-shadow-md">
          Gemeinsam für eine saubere Stadt
        </p>
      </div>
    </div>
  </div>

  <div class="px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto -mt-8 pb-16">
    <%# Statistics card %>
    <%= render "shared/statistics_card", clean_ups: @total_cleanups, participants: @total_participants, total_cigarettes: @total_cigarettes %>



    <%# Status card %>
    <div class="mb-6 bg-white rounded-2xl shadow-lg p-8 border border-gray-100 relative z-10 text-center">
      <div
        class="
          flex items-center justify-center w-16 h-16 bg-yellow-100
          rounded-full mx-auto mb-6
        "
      >
        <svg
          class="w-8 h-8 text-yellow-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      </div>

      <h2 class="text-xl font-semibold text-gray-900 mb-3">
        Aktuell kein Clean-Up geplant
      </h2>

      <p class="text-gray-600 mb-6">
        Im Moment gibt es leider keinen aktiven Clean-Up, für den du dich
        anmelden kannst. Schaue bald wieder vorbei!
      </p>

      <div class="border-t border-gray-100 pt-6 mt-6">
        <h3 class="text-sm font-medium text-gray-900 mb-4">
          Was ist Trashcan Dresden?
        </h3>

        <p class="text-sm text-gray-500">
          Wir sind eine Initiative, die regelmäßig gemeinsame Müllsammelaktionen
          in Dresden organisiert. Jeder kann mitmachen und einen Beitrag zu
          einer saubereren Umwelt leisten.
        </p>
      </div>
    </div>

    <%# Instagram link %>
    <%= render "shared/instagram_link" %>
  </div>
</div>
