<%= turbo_stream_from :clean_ups %>

<div class="min-h-screen bg-gradient-to-b from-indigo-50 to-white">
  <%# Hero banner %>
  <%= render "shared/hero_banner", 
      title: "Willkommen bei Trashcan Dresden!", 
      icon_container_size: "w-24 h-24",
      icon_size: "w-14 h-14", 
      icon_margin: "mb-6" %>

  <div class="px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto -mt-8 pb-16">
    <%# Statistics card %>
    <%= render "shared/statistics_card", clean_ups: @total_cleanups, participants: @total_participants, total_cigarettes: @total_cigarettes %>



    <%# Status card %>
    <div class="mb-6 bg-white rounded-2xl shadow-lg p-8 border border-gray-100 relative z-10 text-center">
      <div
        class="
          flex items-center justify-center w-16 h-16 bg-yellow-100
          rounded-full mx-auto mb-6
        "
      >
        <svg
          class="w-8 h-8 text-yellow-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      </div>

      <h2 class="text-xl font-semibold text-gray-900 mb-3">
        Aktuell kein Clean-Up geplant
      </h2>

      <p class="text-gray-600 mb-6">
        Im Moment gibt es leider keinen aktiven Clean-Up, für den du dich
        anmelden kannst. Schaue bald wieder vorbei!
      </p>

      <div class="border-t border-gray-100 pt-6 mt-6">
        <h3 class="text-sm font-medium text-gray-900 mb-4">
          Was ist Trashcan Dresden?
        </h3>

        <p class="text-sm text-gray-500">
          Wir sind eine Initiative, die regelmäßig gemeinsame Müllsammelaktionen
          in Dresden organisiert. Jeder kann mitmachen und einen Beitrag zu
          einer saubereren Umwelt leisten.
        </p>
      </div>
    </div>

    <%# Instagram link %>
    <%= render "shared/instagram_link" %>
  </div>
</div>
