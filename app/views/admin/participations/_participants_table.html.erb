<%= turbo_frame_tag "participants_table" do %>
  <div id="table" class="mt-10">
    <div class="sm:flex sm:items-center">
      <div class="sm:flex-auto">
        <h1 class="block text-sm/6 font-medium text-gray-900">Teilnehmer</h1>
      </div>
    </div>
    <div class="mt-2 flow-root">
      <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
          <div class="overflow-hidden ring-1 shadow-sm ring-black/5 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-300">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
                  <th scope="col" class="px-3 py-3.5 text-sm font-semibold text-gray-900 text-center">Gruppengröße</th>
                  <th scope="col" class="px-3 py-3.5 text-sm font-semibold text-gray-900 text-center">Status</th>
                  <th scope="col" class="px-3 py-3.5 text-sm font-semibold text-gray-900 text-center">Aktionen</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200 bg-white">
                <% clean_up.participations.each do |participation| %>
                  <tr>
                    <td class="py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-gray-900 sm:pl-6"><%= participation.participant.name %></td>
                    <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 text-center"><%= participation.participant.people_count %></td>
                    <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 text-center">
                      <% color = participation.color_by_status %>
                      <% label = participation.label_by_status %>
                      <%= render 'shared/badge', label: label, color: color %>
                    </td>
                    <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 text-center">
                      <div class="flex justify-center gap-2">
                        <%# Status change buttons %>
                        <% if clean_up.started? %>
                          <% if participation.status == "registered" %>
                            <%= form_with url: change_status_admin_clean_up_participation_path(clean_up, participation, status_action: 'start'),
                                method: :post,
                                data: { turbo_frame: "participants_table" } do %>
                              <button type="submit" class="inline-flex items-center gap-x-1 rounded-md bg-green-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-green-500 cursor-pointer">
                                Starten
                              </button>
                            <% end %>
                          <% elsif participation.status == "started" %>
                            <%= form_with url: change_status_admin_clean_up_participation_path(clean_up, participation, status_action: 'return'),
                                method: :post,
                                data: { turbo_frame: "participants_table" } do %>
                              <button type="submit" class="inline-flex items-center gap-x-1 rounded-md bg-yellow-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-yellow-500 cursor-pointer">
                                Zurück
                              </button>
                            <% end %>
                          <% end %>
                        <% end %>

                        <%# Remove button - only for participants in registered state %>
                        <% if !clean_up.ended? && participation.status == "registered" %>
                          <%= form_with url: admin_clean_up_participation_path(clean_up, participation),
                              method: :delete do %>
                            <button type="button"
                                    data-action="click->confirm-modal#open"
                                    data-confirm-message="Möchten Sie <%= participation.participant.name %> wirklich entfernen?"
                                    class="inline-flex items-center gap-x-1 rounded-md bg-red-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-red-500 cursor-pointer">
                              Entfernen
                            </button>
                          <% end %>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
