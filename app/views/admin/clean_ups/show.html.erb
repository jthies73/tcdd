<div class="pt-10 pb-30 px-4 sm:px-6 lg:px-8" data-controller="confirm-modal">
  <div class="flex justify-between items-center">
    <div class="flex justify-start items-center space-x-4">
      <%= link_to admin_clean_ups_path do %>
        <%= icon('arrow-left')%>
      <% end %>
      <h1 class="text-2xl font-semibold text-gray-900">Clean-Up Details</h1>
    </div>

    <div>
      <% label = @clean_up.label_by_status %>
      <% color = @clean_up.color_by_status %>
      <%= render 'shared/badge', label: label, color: color %>
    </div>
  </div>

  <div class="fixed bottom-4 right-4">
    <%# ACTIONS %>
    <% case @clean_up.status %>
      <% when 'created' %>
        <%= render 'shared/button', label: 'Zur Registrierung Freigeben', icon: 'person', color: 'indigo', path: change_status_admin_clean_up_path(clean_up_id: @clean_up.id, change_action: 'enable_registration'), method: :post %>
      <% when 'registration_enabled' %>
        <%= render 'shared/button', label: 'Clean-Up Starten', icon: 'play', color: 'green', path: change_status_admin_clean_up_path(clean_up_id: @clean_up.id, change_action: 'start'), method: :post %>
      <% when 'started' %>
        <%= render 'shared/button', label: 'Clean-Up Beenden', icon: 'stop', color: 'red', path: change_status_admin_clean_up_path(clean_up_id: @clean_up.id, change_action: 'end'), method: :post %>
    <% end %>
  </div>

  <%# CLEAN-UP DETAILS %>
  <div class="gap-5 grid grid-cols-1 mt-6">
    <div>
      <label for="name" class="block text-sm/6 font-medium text-gray-900">Name</label>
      <div class="mt-2">
        <input type="name" name="name" id="name" value="<%= @clean_up.name %>" disabled class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:outline-gray-200 sm:text-sm/6">
      </div>
    </div>
    <div>
      <label for="description" class="block text-sm/6 font-medium text-gray-900">Beschreibung</label>
      <div class="mt-2">
        <textarea type="description" name="description" id="description" disabled class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:outline-gray-200 sm:text-sm/6"><%= @clean_up.description %></textarea>
      </div>
    </div>
    <div>
      <label for="name" class="block text-sm/6 font-medium text-gray-900">Datum</label>
      <div class="mt-2">
        <input type="name" name="name" id="name" value="<%= @clean_up.starts_at.strftime("%d.%m.%Y %H:%M") %>" disabled class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:outline-gray-200 sm:text-sm/6">
      </div>
    </div>
    <div>
      <label for="description" class="block text-sm/6 font-medium text-gray-900">Adresse</label>
      <div class="mt-2">
        <textarea type="description" name="description" id="description" disabled class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:outline-gray-200 sm:text-sm/6"><%= @clean_up.address %></textarea>
      </div>
    </div>
  </div>


  <%# ADD PARTICIPANT FORM %>
  <% if @clean_up.registerable? %>
    <div class="mt-10">
      <h2 class="block text-sm/6 font-medium text-gray-900">Teilnehmer hinzufügen</h2>
      <%= form_with url: admin_clean_up_participations_path(@clean_up), method: :post, local: true, class: "mt-2" do |f| %>
        <div class="flex gap-4 items-end">
          <div class="flex-1">
            <label for="participant_id" class="block text-sm/6 font-medium text-gray-900">Bestehender Teilnehmer</label>
            <select name="participant_id" id="participant_id" class="mt-2 block w-full h-[38px] rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
              <option value="">-- Oder neuen Namen eingeben --</option>
              <% @participants.each do |participant| %>
                <option value="<%= participant.id %>"><%= participant.name %> (<%= participant.people_count %> Personen)</option>
              <% end %>
            </select>
          </div>
          <div class="flex-1">
            <label for="participant_name" class="block text-sm/6 font-medium text-gray-900">Neuer Name</label>
            <input type="text" name="participant_name" id="participant_name" class="mt-2 block w-full h-[38px] rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
          </div>
          <div class="w-32">
            <label for="participant_people_count" class="block text-sm/6 font-medium text-gray-900">Gruppengröße</label>
            <input type="number" name="participant_people_count" id="participant_people_count" value="1" min="1" class="mt-2 block w-full h-[38px] rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
          </div>
          <div>
            <button type="submit" class="mt-2 inline-flex items-center justify-center gap-x-2 h-[38px] rounded-md bg-indigo-600 px-4 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer">
              Hinzufügen
            </button>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# PARTICIPANTS TABLE %>
  <%= render "admin/participations/participants_table", clean_up: @clean_up %>

  <%# CONFIRMATION MODAL %>
  <div data-confirm-modal-target="modal"
       data-action="keydown@window->confirm-modal#closeOnEscape click->confirm-modal#closeOnOutsideClick"
       class="hidden fixed inset-0 z-50 overflow-y-auto"
       aria-labelledby="modal-title"
       role="dialog"
       aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <%# Background overlay %>
      <div class="fixed inset-0 bg-gray-500/75 transition-opacity" aria-hidden="true"></div>

      <%# Modal panel %>
      <div class="inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">
        <div class="sm:flex sm:items-start">
          <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">
              Teilnehmer entfernen
            </h3>
            <div class="mt-2">
              <p class="text-sm text-gray-500" data-confirm-modal-target="message">
                Möchten Sie diesen Teilnehmer wirklich entfernen?
              </p>
            </div>
          </div>
        </div>
        <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
          <button type="button"
                  data-action="click->confirm-modal#confirm"
                  class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm cursor-pointer">
            Entfernen
          </button>
          <button type="button"
                  data-action="click->confirm-modal#close"
                  class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:w-auto sm:text-sm cursor-pointer">
            Abbrechen
          </button>
        </div>
      </div>
    </div>
  </div>
</div>