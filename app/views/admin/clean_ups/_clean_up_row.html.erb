<tr
  id="admin_clean_up_row_<%= clean_up.id %>"
  class="hover:bg-gray-50 cursor-pointer"
  onclick="window.location='<%= admin_clean_up_path(clean_up) %>'"
>
  <td
    class="
      py-4 pl-4 pr-3 text-sm whitespace-nowrap text-gray-500 sm:pl-6
      text-center
    "
  >
    <%= local_assigns.fetch(:number, clean_up.id) %>
  </td>

  <td class="py-4 pr-3 text-sm font-medium whitespace-nowrap text-gray-900">
    <%= clean_up.name %>
  </td>

  <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500">
    <%= clean_up.starts_at.hour == 0 && clean_up.starts_at.min == 0 ? clean_up.starts_at.strftime("%d.%m.%Y") : clean_up.starts_at.strftime("%d.%m.%Y %H:%M") %>
  </td>

  <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 text-center">
    <%= clean_up.participant_count.zero? ? 'N/A' : clean_up.participant_count %>
  </td>

  <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 text-center">
    <%= clean_up.total_cigarettes_count.zero? ? 'N/A' : clean_up.total_cigarettes_count %>
  </td>

  <td class="px-3 py-4 text-sm whitespace-nowrap text-gray-500 text-center">
    <% color = clean_up.color_by_status %>
    <% label = clean_up.label_by_status %>
    <%= render 'shared/badge', label: label, color: color %>
  </td>
</tr>
