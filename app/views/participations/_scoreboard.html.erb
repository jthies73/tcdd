<%= turbo_frame_tag "scoreboard_#{clean_up.id}" do %>
  <% top_participants = clean_up.participations
                          .where(status: 'returned')
                          .where.not(cigarettes_count: nil)
                          .where('cigarettes_count > 0')
                          .joins(:participant)
                          .order(cigarettes_count: :desc)
                          .limit(10) %>

  <% if top_participants.any? %>
    <div
      class="
        bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden
        mt-6
      "
    >
      <div class="bg-amber-300 px-6 py-4">
        <div class="flex items-center justify-center">
          <span class="text-2xl mr-5">👑</span>

          <span class="text-lg font-semibold text-yellow-900">
            Kippen-Krönungstafel
          </span>

          <span class="text-2xl ml-5">👑</span>
        </div>
      </div>

      <div class="px-6 py-6">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-3 px-2 text-sm font-semibold text-gray-700">
                  Rang
                </th>

                <th class="text-left py-3 px-4 text-sm font-semibold text-gray-700">
                  Teilnehmer
                </th>

                <th class="text-right py-3 px-2 text-sm font-semibold text-gray-700">
                  Kippen
                </th>
              </tr>
            </thead>

            <tbody>
              <% top_participants.each_with_index do |p, index| %>
                <tr class="border-b border-gray-100 <%= 'bg-yellow-50' if p.id == participation.id %>">
                  <td class="py-3 px-2">
                    <% if index == 0 %>
                      <span class="text-2xl">🥇</span>
                    <% elsif index == 1 %>
                      <span class="text-2xl">🥈</span>
                    <% elsif index == 2 %>
                      <span class="text-2xl">🥉</span>
                    <% else %>
                      <span class="text-gray-600 font-medium">
                        #<%= index + 1 %>
                      </span>
                    <% end %>
                  </td>

                  <td class="py-3 px-4">
                    <span class="<%= 'font-bold text-indigo-700' if p.id == participation.id %>">
                      <%= p.participant.name %>
                    </span>

                    <% if p.id == participation.id %>
                      <span class="ml-2 text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded">
                        Du
                      </span>
                    <% end %>
                  </td>

                  <td class="py-3 px-2 text-right">
                    <span class="font-semibold text-gray-900">
                      <%= p.cigarettes_count %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
