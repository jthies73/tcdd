<%= turbo_stream_from @latest_clean_up %>
<%= turbo_stream_from :clean_ups %>

<div class="min-h-screen bg-gradient-to-b from-indigo-50 to-white">
  <div class="pt-10 pb-20 px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto">
    <%# Logo and brand header %>
    <div class="text-center mb-8">
      <div
        class="
          inline-flex items-center justify-center w-20 h-20 bg-indigo-600
          rounded-full shadow-lg mb-4
        "
      >
        <svg
          class="w-12 h-12 text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"
          />
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-gray-900">
        Willkommen bei Trashcan Dresden!
      </h1>

      <p class="text-gray-600 mt-2">Gemeinsam für eine saubere Stadt</p>
    </div>

    <%# Clean-up info card %>
    <div
      class="
        bg-white rounded-2xl shadow-lg border border-gray-100
        overflow-hidden mb-8
      "
    >
      <div class="bg-indigo-600 px-6 py-4">
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-indigo-200 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>

          <h2 class="text-lg font-semibold text-white">Nächster Clean-Up</h2>
        </div>
      </div>

      <div class="px-6 py-5">
        <h3 class="text-xl font-bold text-gray-900 mb-3">
          <%= @latest_clean_up.name %>
        </h3>

        <% if @latest_clean_up.description.present? %>
          <p class="text-gray-600 mb-4"><%= @latest_clean_up.description %></p>
        <% end %>

        <div class="space-y-3">
          <div class="flex items-center text-gray-700">
            <svg
              class="w-5 h-5 text-indigo-500 mr-3 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>

            <span class="font-medium">
              <%= @latest_clean_up.starts_at.strftime("%d.%m.%Y um %H:%M") %>
              Uhr
            </span>
          </div>

          <div class="flex items-center text-gray-700">
            <svg
              class="w-5 h-5 text-indigo-500 mr-3 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>

            <span><%= @latest_clean_up.address %></span>
          </div>

          <div class="flex items-center text-gray-700">
            <svg
              class="w-5 h-5 text-green-500 mr-3 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              />
            </svg>

            <span>
              <%= @latest_clean_up.participant_count %> Teilnehmer*innen
              registriert
            </span>
          </div>
        </div>
      </div>
    </div>

    <%# Returning participant section %>
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 mb-6">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-100 rounded-t-2xl">
        <h3 class="text-base font-semibold text-gray-900 flex items-center">
          <svg
            class="w-5 h-5 text-indigo-500 mr-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          Schon mal dabei gewesen?
        </h3>

        <p class="text-sm text-gray-500 mt-1">
          Wähle deinen Namen aus der Liste:
        </p>
      </div>

      <div class="px-6 py-5">
        <%= form_with url: participations_path, method: :post, local: true do |form| %>
          <div class="space-y-4">
            <div data-controller="searchable-select" class="relative">
              <%= form.hidden_field :participant_id, data: { searchable_select_target: "hiddenField" } %>

              <div class="relative">
                <input
                  type="text"
                  data-searchable-select-target="input"
                  data-action="input->searchable-select#filter focus->searchable-select#focusInput blur->searchable-select#hideList"
                  placeholder="Name suchen oder auswählen..."
                  autocomplete="off"
                  class="
                    block w-full rounded-lg bg-gray-50 border
                    border-gray-200 px-4 py-3 pr-10 text-gray-900
                    placeholder:text-gray-400 focus:border-indigo-500
                    focus:ring-2 focus:ring-indigo-200 focus:bg-white
                    transition-colors sm:text-sm
                  "
                >

                <div
                  class="
                    absolute inset-y-0 right-0 flex items-center pr-3
                    pointer-events-none
                  "
                >
                  <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                    />
                  </svg>
                </div>
              </div>

              <ul
                data-searchable-select-target="list"
                class="
                  hidden absolute z-10 mt-1 w-full bg-white border
                  border-gray-200 rounded-lg shadow-lg max-h-60
                  overflow-auto
                "
              >
                <% Participant.alphabetically.each do |participant| %>
                  <li
                    data-searchable-select-target="item"
                    data-id="<%= participant.id %>"
                    data-name="<%= participant.name %>"
                    data-action="click->searchable-select#select"
                    class="
                      px-4 py-3 cursor-pointer hover:bg-indigo-50 border-b
                      border-gray-100 last:border-b-0 transition-colors
                      text-gray-900 sm:text-sm
                    "
                  >
                    <%= participant.name %>
                  </li>
                <% end %>

                <li
                  data-searchable-select-target="noResults"
                  class="hidden px-4 py-3 text-gray-500 text-center sm:text-sm"
                >
                  Kein Eintrag gefunden
                </li>
              </ul>
            </div>

            <%= form.submit "Anmelden", class: "w-full rounded-xl bg-indigo-600 px-4 py-3 text-base font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>

    <%# New participant section %>
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-100">
        <h3 class="text-base font-semibold text-gray-900 flex items-center">
          <svg
            class="w-5 h-5 text-green-500 mr-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
            />
          </svg>
          Zum ersten Mal hier?
        </h3>

        <p class="text-sm text-gray-500 mt-1">
          Gib einen Spitznamen oder Gruppennamen an, damit wir prüfen können, ob
          alle sicher zurück sind.
        </p>
      </div>

      <div class="px-6 py-5">
        <%= form_with url: participations_path, method: :post, local: true do |form| %>
          <div class="space-y-4">
            <div>
              <%= form.label :participant_name, "Name / Gruppenname", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.text_field :participant_name, placeholder: "z.B. Max oder Team Neustadt", class: "block w-full rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:bg-white transition-colors sm:text-sm" %>
            </div>

            <div>
              <%= form.label :participant_people_count, "Gruppengröße", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= form.number_field :participant_people_count, value: 1, min: 1, class: "block w-full rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:bg-white transition-colors sm:text-sm" %>

              <p class="mt-1 text-xs text-gray-500">
                Wie viele Personen seid ihr insgesamt?
              </p>
            </div>

            <%= form.submit "Neu registrieren", class: "w-full rounded-xl bg-green-600 px-4 py-3 text-base font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600 cursor-pointer transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
