<%= turbo_stream_from @latest_clean_up %>
<%= turbo_stream_from :clean_ups %>

<div class="min-h-screen bg-gradient-to-b from-indigo-50 to-white">
  <%# Hero banner %>
  <%= render "shared/hero_banner", 
      title: "Willkommen bei Trashcan Dresden!", 
      icon_container_size: "w-20 h-20",
      icon_size: "w-12 h-12",
      icon_margin: "mb-4" %>

  <div class="px-4 sm:px-8 max-w-2xl mx-auto -mt-8 pb-20">
    <%# Statistics card %>
    <%= render "shared/statistics_card", clean_ups: @total_cleanups, participants: @total_participants, total_cigarettes: @total_cigarettes %>

    <%# Clean-up info card %>
    <div
      class="
        bg-white rounded-2xl shadow-lg border border-gray-100
        overflow-hidden mb-8 relative z-10
      "
    >
      <div class="bg-indigo-600 px-6 py-4">
        <div class="flex items-center">
          <svg
            class="w-6 h-6 text-indigo-200 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>

          <h2 class="text-lg font-semibold text-white">Nächster Clean-Up</h2>
        </div>
      </div>

      <div class="px-6 py-5">
        <h3 class="text-xl font-bold text-gray-900 mb-3">
          <%= @latest_clean_up.name %>
        </h3>

        <% if @latest_clean_up.description.present? %>
          <p class="text-gray-600 mb-4"><%= @latest_clean_up.description %></p>
        <% end %>

        <div class="space-y-3">
          <div class="flex items-center text-gray-700">
            <svg
              class="w-5 h-5 text-indigo-500 mr-3 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>

            <span class="font-medium">
              <%= @latest_clean_up.starts_at.in_time_zone("Europe/Berlin").strftime("%d.%m.%Y um %H:%M") %>
              Uhr
            </span>
          </div>

          <div class="flex items-start text-gray-700">
            <svg
              class="w-5 h-5 text-indigo-500 mr-3 flex-shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              />

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>

            <div class="flex flex-col">
              <span><%= @latest_clean_up.address %></span>

              <%= link_to "https://www.google.com/maps/search/?api=1&query=#{ERB::Util.url_encode(@latest_clean_up.address.to_s)}", 
                          target: "_blank", 
                          rel: "noopener noreferrer",
                          class: "inline-flex items-center text-sm text-indigo-600 hover:text-indigo-500 mt-1" do %>
                <svg
                  class="w-4 h-4 mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
                In Karten öffnen
              <% end %>
            </div>
          </div>

          <div class="flex items-center text-gray-700">
            <svg
              class="w-5 h-5 text-green-500 mr-3 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              />
            </svg>

            <span>
              <%= @latest_clean_up.participant_count %> Teilnehmer*innen
              registriert
            </span>
          </div>
        </div>

        <%# Calendar download button %>
        <div class="mt-5 pt-5 border-t border-gray-100">
          <%= link_to calendar_clean_up_path(@latest_clean_up), 
                      class: "inline-flex items-center justify-center w-full rounded-lg bg-indigo-50 px-4 py-3 text-sm font-medium text-indigo-600 hover:bg-indigo-100 transition-colors" do %>
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />

              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 11v6m-3-3h6"
              />
            </svg>
            Zum Kalender hinzufügen
          <% end %>
        </div>
      </div>
    </div>

    <%# Returning participant section %>
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 mb-6">
      <div class="px-6 py-4 rounded-t-2xl">
        <h3 class="text-base font-semibold text-gray-900 flex items-center">
          <svg
            class="w-5 h-5 text-indigo-500 mr-2"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
          Schon mal dabei gewesen?
        </h3>

        <p class="text-sm text-gray-500 mt-1">
          Wähle deinen Namen aus der Liste:
        </p>
      </div>

      <div class="px-6 py-5">
        <%= form_with url: participations_path, method: :post, local: true do |form| %>
          <div class="space-y-4">
            <%= render "shared/searchable_participant_select", 
                participants: Participant.alphabetically, 
                field_name: "participant_id",
                style: :card %>

            <%= form.submit "Anmelden", class: "w-full rounded-xl bg-indigo-600 px-4 py-3 text-base font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 cursor-pointer transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>

    <%= render "participations/new_participant_form" %>

    <%# Instagram link %>
    <%= render "shared/instagram_link" %>
  </div>
</div>
