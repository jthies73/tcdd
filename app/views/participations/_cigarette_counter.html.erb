<div id="cigarette_counter_<%= participation.id %>"
     data-controller="cigarette-counter"
     data-cigarette-counter-participation-id-value="<%= participation.id %>"
     data-cigarette-counter-current-count-value="<%= participation.cigarettes_count || 0 %>"
     data-cigarette-counter-debounce-timer-value="2000"
     class="bg-gray-100 rounded-lg shadow-sm p-6">
  <h2 class="text-lg font-semibold text-gray-900 mb-4">Gesammelte Zigaretten</h2>
  
  <div class="flex items-center justify-center gap-4">
    <button type="button"
            data-cigarette-counter-target="decrementButton"
            data-action="click->cigarette-counter#decrement"
            class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-full w-12 h-12 flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
      </svg>
    </button>
    
    <input type="number"
           data-cigarette-counter-target="input"
           data-action="change->cigarette-counter#updateValue"
           value="<%= participation.cigarettes_count || 0 %>"
           min="0"
           class="text-2xl text-center bg-transparent border-none focus:outline-none w-24">
    
    <button type="button"
            data-cigarette-counter-target="incrementButton"
            data-action="click->cigarette-counter#increment"
            class="bg-indigo-600 hover:bg-indigo-500 text-white rounded-full w-12 h-12 flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
    </button>
  </div>
</div>
