<%# Participation is active %>
<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden mb-6">
  <div class="bg-green-600 px-6 py-4">
    <div class="flex items-center justify-center">
      <div class="w-3 h-3 bg-white rounded-full mr-3 animate-pulse"></div>
      <span class="text-lg font-semibold text-white">Clean-Up läuft</span>
    </div>
  </div>
  <div class="px-6 py-6 text-center">
    <h2 class="text-lg font-semibold text-gray-900 mb-2">Du bist dabei! 🎉</h2>
    
    <%# Elapsed timer %>
    <div class="my-4" data-controller="elapsed-timer" data-elapsed-timer-start-time-value="<%= participation.started_at || Time.current %>">
      <div class="inline-flex items-center justify-center bg-gray-100 rounded-xl px-6 py-3">
        <svg class="w-5 h-5 text-green-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-2xl font-mono font-bold text-gray-900" data-elapsed-timer-target="display">00:00:00</span>
      </div>
    </div>
    
    <p class="text-gray-600 text-sm">
      Klicke auf <strong>Beenden</strong>, wenn du wieder am Treffpunkt angekommen bist, 
      damit wir wissen, dass du sicher zurück bist.
    </p>
  </div>
</div>

<%# Cigarettes counter card %>
<div class="mb-6">
  <%= render 'participations/cigarettes_counter', participation: participation %>
</div>

<%# Group sharing info box %>
<div class="mb-20 bg-blue-50 rounded-xl p-4 border border-blue-100" data-controller="clipboard">
  <div class="flex items-start">
    <svg class="w-5 h-5 text-blue-600 mt-0.5 mr-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <div class="flex-1">
      <p class="text-sm text-blue-800 mb-3">
        <strong>Gruppenfunktion:</strong> Teile diesen Link mit deiner Gruppe – alle können gemeinsam Kippen zählen!
      </p>
      <div class="flex items-center gap-2">
        <input type="text" readonly value="<%= show_participation_url(participation) %>" 
               data-clipboard-target="source"
               class="flex-1 text-xs bg-white border border-blue-200 rounded-lg px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <button type="button" data-action="click->clipboard#copy"
                class="inline-flex items-center gap-1 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-3 py-2 rounded-lg transition-colors">
          <svg data-clipboard-target="copyIcon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <svg data-clipboard-target="successIcon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Kopieren</span>
        </button>
      </div>
    </div>
  </div>
</div>

<%= form_with url: participation_path(participation), method: :patch, local: true do |f| %>
  <%= f.hidden_field :participation_action, value: "return" %>
  <div class="fixed bottom-4 right-4">
    <%= render 'shared/button', label: 'Beenden', icon: 'stop', color: 'red', type: 'submit' %>
  </div>
<% end %>
