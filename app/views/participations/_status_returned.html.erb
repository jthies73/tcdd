<%# Participation completed %>
<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
  <div class="bg-indigo-600 px-6 py-4">
    <div class="flex items-center justify-center">
      <svg
        class="w-6 h-6 text-indigo-200 mr-2"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>

      <span class="text-lg font-semibold text-white">Abgeschlossen</span>
    </div>
  </div>

  <div class="px-6 py-8 text-center">
    <div
      class="
        inline-flex items-center justify-center w-24 h-24 bg-green-100
        rounded-full mb-6
      "
    >
      <svg
        class="w-14 h-14 text-green-600"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
        />
      </svg>
    </div>

    <h2 class="text-2xl font-bold text-gray-900 mb-3">Vielen Dank!</h2>

    <p class="text-gray-600 mb-6">
      Danke, dass du dabei warst und einen Beitrag für eine saubere Stadt
      geleistet hast! Gemeinsam machen wir Dresden schöner. 💚
    </p>

    <% if participation.cigarettes_count && participation.cigarettes_count > 0 %>
      <div class="bg-indigo-50 rounded-xl p-4 border border-indigo-100 mb-4">
        <p class="text-lg font-semibold text-indigo-800">
          🚬 <%= participation.cigarettes_count %> Kippen gesammelt
        </p>

        <p class="text-sm text-indigo-600 mt-1">Super! Jede einzelne zählt!</p>
      </div>
    <% end %>

    <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
      <p class="text-sm text-gray-600">
        Wir freuen uns, dich beim nächsten Clean-Up wiederzusehen!
      </p>
    </div>
  </div>
</div>

<%# Scoreboard %>
<% top_participants = participation.clean_up.participations
                        .where(status: 'returned')
                        .where. not(cigarettes_count: nil)
                        .where('cigarettes_count > 0')
                        .joins(:participant)
                        .order(cigarettes_count: :desc)
                        .limit(10) %>

<% if top_participants.any? %>
  <div
    class="
      bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden
      mt-6
    "
  >
    <div class="bg-amber-300 px-6 py-4">
      <div class="flex items-center justify-center">
        <span class="text-2xl mr-5">👑</span>

        <span class="text-lg font-semibold text-yellow-900">
          Kippen-Krönungstafel
        </span>

        <span class="text-2xl ml-5">👑</span>
      </div>
    </div>

    <div class="px-6 py-6">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left py-3 px-2 text-sm font-semibold text-gray-700">
                Rang
              </th>

              <th class="text-left py-3 px-4 text-sm font-semibold text-gray-700">
                Teilnehmer
              </th>

              <th class="text-right py-3 px-2 text-sm font-semibold text-gray-700">
                Kippen
              </th>
            </tr>
          </thead>

          <tbody>
            <% top_participants. each_with_index do |p, index| %>
              <tr class="border-b border-gray-100 <%= 'bg-yellow-50' if p.id == participation.id %>">
                <td class="py-3 px-2">
                  <% if index == 0 %>
                    <span class="text-2xl">🥇</span>
                  <% elsif index == 1 %>
                    <span class="text-2xl">🥈</span>
                  <% elsif index == 2 %>
                    <span class="text-2xl">🥉</span>
                  <% else %>
                    <span class="text-gray-600 font-medium">
                      #<%= index + 1 %>
                    </span>
                  <% end %>
                </td>

                <td class="py-3 px-4">
                  <span class="<%= 'font-bold text-indigo-700' if p.id == participation. id %>">
                    <%= p.participant.name %>
                  </span>

                  <% if p.id == participation.id %>
                    <span class="ml-2 text-xs bg-indigo-100 text-indigo-700 px-2 py-1 rounded">
                      Du
                    </span>
                  <% end %>
                </td>

                <td class="py-3 px-2 text-right">
                  <span class="font-semibold text-gray-900">
                    <%= p.cigarettes_count %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% end %>
